rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    match /system/connection_test {
      allow read, write: if true;
    }

    match /ccmMeetings/{docId} {
      allow read, write: if true;
    }

    match /staff/{docId} {
      allow read, write: if true;
    }

    match /classes/{docId} {
      allow read, write: if true;
    }

    match /tasks/{docId} {
      allow read, write: if true;
    }

    match /observations/{docId} {
      allow read, write: if true;
    }

    match /monitoring/{docId} {
      allow read, write: if true;
    }

    match /attendance/{docId} {
      allow read, write: if true;
    }

    match /lessonPlans/{docId} {
      allow read, write: if true;
    }

    match /hodReports/{docId} {
      allow read, write: if true;
    }

    match /hodFacultyAttendance/{docId} {
      allow read, write: if true;
    }

    match /notifications/{docId} {
      allow read, write: if true;
    }

        match /skillBankStudents/{docId} {
      allow read, write: if true;
    }

    match /mentorMappings/{docId} {
      allow read, write: if true;
    }

    match /facultyKpis/{docId} {
      allow read, write: if true;
    }

    match /departmentRankings/{docId} {
      allow read, write: if true;
    }

    match /events/{docId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /cdcQuestions/{docId} {
      allow read, write: if true;
    }

    match /cdcExams/{docId} {
      allow read, write: if true;
    }

    match /cdcStudents/{docId} {
      allow read, write: if true;
    }

    match /cdcExamAttempts/{docId} {
      allow read, write: if true;
    }

    match /cdcSuspiciousLogs/{docId} {
      allow read, write: if true;
    }

    match /systemLogs/{docId} {
      allow read, write: if true;
    }
  }
}
